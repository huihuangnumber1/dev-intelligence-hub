{
  "name": "dev-intelligence-hub",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local-first engineering command center with autonomous roles, cited memory, controlled execution, and owner-confirmed actions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huihuangnumber1/dev-intelligence-hub.git"
  },
  "homepage": "https://github.com/huihuangnumber1/dev-intelligence-hub#readme",
  "bugs": {
    "url": "https://github.com/huihuangnumber1/dev-intelligence-hub/issues"
  },
  "keywords": [
    "ai-agents",
    "developer-tools",
    "github",
    "local-first",
    "ollama",
    "workflow-automation"
  ],
  "files": [
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "config.example.json",
    "docs/ARCHITECTURE.md",
    "docs/OPERATIONS.md",
    "docs/PRIVACY.md",
    "docs/PROJECT_STATUS.md",
    "npm-shrinkwrap.json",
    "public/",
    "scripts/",
    "src/"
  ],
  "type": "module",
  "scripts": {
    "start": "node scripts/run-dashboard.mjs",
    "refresh": "node src/cli.js refresh",
    "refresh:notify": "node src/cli.js refresh --notify",
    "cleanup:e2e-pr": "node scripts/cleanup-github-smoke-pr.mjs",
    "setup:validation-browser": "node scripts/install-validation-browser.mjs",
    "test": "node --test --test-concurrency=4 --test-reporter=tap test/00-u9-priority.mjs \"test/*.test.js\" \"test/*.test.mjs\" && node --test --test-concurrency=1 --test-reporter=tap test/open-source-distribution.mjs",
    "validate:system": "node scripts/validate-system.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
